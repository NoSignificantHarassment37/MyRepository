# Supabase Configuration
# Para esta aplicación solo necesitas las credenciales de Supabase Storage
# NO necesitas la cadena de conexión de la base de datos

# SUPABASE_URL: URL de tu proyecto Supabase
# Encuéntrala en: Settings > API > Project URL
# Ejemplo: https://xxxxx.supabase.co
SUPABASE_URL=https://ukvpvrmcztazfowemkuq.supabase.co

# SUPABASE_KEY: Clave anónima (anon key) o Service Role Key
# Encuéntrala en: Settings > API > Project API keys
# Usa la "anon" key para acceso público o "service_role" key para acceso completo
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=sb_publishable_pHo5Mm_5XBSDpP19W905zQ_fH6xRUxm

# Server Configuration
PORT=3000

# NOTA: Asegúrate de crear un bucket llamado "images" en Supabase Storage
# Ve a: Storage > Create a new bucket > Nombre: "images"

